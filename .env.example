# 本地开发示例。生产值通过 Secret Manager 注入，不要提交真实密钥。
DATABASE_URL="mysql://marketstars:marketstars@localhost:3306/marketstars"
APP_BASE_URL="http://localhost:3000"
SESSION_SECRET="change-me-local-only-32-bytes-minimum"
# oidc: 接入公共 SSO（lth2015/sso）；demo: 仅本地/开发环境的演示身份（生产禁止）
AUTH_MODE="demo"
OIDC_ISSUER="http://auth.localhost:4464/"
OIDC_CLIENT_ID="marketstars-local"
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:3000/auth/callback"
OIDC_SCOPES="openid offline_access platform:read"
SSO_API_BASE_URL="http://api.localhost:8083"
SSO_API_AUDIENCE="https://api.sso.local"
SSO_ACCOUNT_URL="http://auth.localhost:8080/account"
SSO_CONSOLE_URL="http://auth.localhost:8080/console"
SSO_LOGOUT_URL="http://auth.localhost:8080/sso/logout"
# 运营空间：只有该 SSO 租户内且持有 OperatorGrant 的用户能进入 /admin
OPERATOR_SSO_TENANT_ID="demo-ops-tenant"
JOB_TOKEN="local-job-token"
# 示范接入应用（POP 文案生成）的服务端 client secret
LAUNCH_CLIENT_SECRET_POP_WRITER="local-pop-writer-secret"

# 仅 dev/本地：在 NODE_ENV=production 下仍允许 demo 登录（staging/production 禁止设置）
ALLOW_DEMO_AUTH="true"
PAYMENT_WEBHOOK_SECRET="local-payment-webhook-secret"
# 统一模型网关：设置 ANTHROPIC_API_KEY 后调用 Claude，否则使用 mock 模型
# ANTHROPIC_API_KEY=""
MODEL_GATEWAY_DEFAULT_MODEL="claude-opus-5-5"

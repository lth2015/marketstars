# 复制为 .env.local-sso 后填写（与 lth2015/sso 本地栈联调用）。不要提交真实 secret。
DATABASE_URL=mysql://marketstars:marketstars@127.0.0.1:3307/marketstars
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-local-only-32-bytes-minimum
AUTH_MODE=oidc
OIDC_ISSUER=http://auth.localhost:4464/
OIDC_CLIENT_ID=marketstars-local
OIDC_CLIENT_SECRET=<注册 client 时设置的 secret>
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPES=openid offline_access platform:read
SSO_API_BASE_URL=http://api.localhost:8083
SSO_API_AUDIENCE=https://api.sso.local
SSO_ACCOUNT_URL=http://auth.localhost:8080/account
SSO_CONSOLE_URL=http://console.localhost:3003
SSO_LOGOUT_URL=http://auth.localhost:8080/sso/logout
OPERATOR_SSO_TENANT_ID=<运营空间的 tenant_id>
JOB_TOKEN=local-job-token
LAUNCH_CLIENT_SECRET_POP_WRITER=local-pop-writer-secret
PAYMENT_WEBHOOK_SECRET=local-payment-webhook-secret

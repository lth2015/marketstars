// MarketStars 业务数据模型。用户/租户/成员资格的权威来源是公共 SSO（lth2015/sso），
// 这里只保存 SSO 稳定 ID 引用及应用目录、权益、账单、审计等业务数据。
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Provider {
  id         String   @id @default(cuid())
  name       String
  websiteUrl String?
  supportUrl String?
  supportEmail String?
  /// 开发者自助：拥有该提供商的 SSO 空间（P1）
  ownerTenantId String?  @unique
  contactEmail  String?
  developerTermsVersion String?
  /// 供应商分成比例（基点，7000 = 70% 归供应商）
  revenueShareBps Int     @default(7000)
  payoutAccount   String? @db.Text
  payouts         PayoutStatement[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  apps       App[]
}

model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)
  apps      App[]
}

model Industry {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)
  apps      App[]
}

model IntegrationTag {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)
  apps      App[]
}

model App {
  id               String    @id @default(cuid())
  slug             String    @unique
  status           String    @default("draft") // draft | published | archived
  acceptingNew     Boolean   @default(true)
  suspendedReason  String?   @db.Text // 事故暂停（应用级）
  internalTest     Boolean   @default(false)
  providerId       String
  provider         Provider  @relation(fields: [providerId], references: [id])
  name             String
  tagline          String    @db.VarChar(400)
  tags             String    @default("") @db.VarChar(500)
  searchText       String    @db.Text // MySQL 8：TEXT 不能有默认值，由代码写入
  iconUrl          String?   @db.VarChar(1000)
  screenshots      Json?
  overview         Json?
  launchUrl        String?   @db.VarChar(1000)
  integrationType  String    @default("external") // sso_integrated | external
  launchClientId   String?   @unique
  hostedBuildId    String?   // integrationType=hosted：本番に反映中のビルド
  supportChannels  Json?
  privacyUrl       String?   @db.VarChar(1000)
  termsUrl         String?   @db.VarChar(1000)
  version          String?
  recommendWeight  Int       @default(0)
  minMonthlyPrice  Int?
  hasFreePlan      Boolean   @default(false)
  hasTrial         Boolean   @default(false)
  maxTrialDays     Int       @default(0)
  draft            Json?
  reviewStatus     String    @default("none") // none | submitted | rejected | approved（开发者提交审核）
  reviewNote       String?   @db.Text
  submittedAt      DateTime?
  ratingAvg        Float?
  ratingCount      Int       @default(0)
  firstPublishedAt DateTime?
  contentUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  categories       Category[]
  industries       Industry[]
  integrationTags  IntegrationTag[]
  plans            PlanVersion[]
  releases         AppRelease[]
  subscriptions    Subscription[]
  cases            ContentEntry[]
  inquiries        Inquiry[]
  ranking          RankingEntry[]
  reviews          Review[]

  @@index([status, firstPublishedAt])
  @@index([reviewStatus])
}

model AppRelease {
  id          String   @id @default(cuid())
  appId       String
  app         App      @relation(fields: [appId], references: [id])
  number      Int
  snapshot    Json
  publishedBy String
  createdAt   DateTime @default(now())

  @@unique([appId, number])
}

/// 发布后不可变的价格版本；修改套餐生成新版本并停用旧版本。
model PlanVersion {
  id                       String   @id @default(cuid())
  appId                    String
  app                      App      @relation(fields: [appId], references: [id])
  planKey                  String
  version                  Int      @default(1)
  current                  Boolean  @default(true)
  name                     String
  priceType                String // free | monthly | contact
  priceJpy                 Int      @default(0) // 含税整数日元 / 每租户每月
  trialDays                Int      @default(0)
  includes                 String   @db.Text
  limits                   String   @db.Text
  externalContractRequired Boolean  @default(false)
  /// 模型 Token 按量单价（日元 / 100 万 Token，0 = 不按量计费）
  tokenPriceJpyPerMTok     Int      @default(0)
  sortOrder                Int      @default(0)
  createdAt                DateTime @default(now())
  subscriptions            Subscription[]
  scheduledFor             Subscription[] @relation("ScheduledPlan")
  paymentIntents           PaymentIntent[]

  @@unique([appId, planKey, version])
  @@index([appId, current])
}

/// 租户级应用订阅/权益。liveKey 在 pending/trialing/active/cancel_scheduled/suspended 时为
/// "tenantId:appId"，借助唯一约束保证同租户同应用最多一份有效申请/订阅。
model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String
  tenantName         String
  appId              String
  app                App       @relation(fields: [appId], references: [id])
  planVersionId      String
  plan               PlanVersion @relation(fields: [planVersionId], references: [id])
  kind               String // free | trial | paid
  status             String // pending | trialing | active | cancel_scheduled | expired | canceled | suspended | rejected | withdrawn
  liveKey            String?   @unique
  priceJpySnapshot   Int
  planNameSnapshot   String
  startedAt          DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  endedAt            DateTime?
  suspendedReason    String?   @db.Text
  statusBeforeSuspend String?
  internalTest       Boolean   @default(false)
  paymentMode        String    @default("invoice") // invoice | card
  autoRenew          Boolean   @default(false)
  paymentMethodId    String?
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  /// 期末生效的套餐变更（paid），或试用中的付费转换申请
  scheduledPlanVersionId String?
  scheduledPlan      PlanVersion? @relation("ScheduledPlan", fields: [scheduledPlanVersionId], references: [id])
  lastChargeError    String?   @db.Text
  /// 租户设置的每月按量费用上限（日元），null = 不限
  usageCapJpy        Int?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  request            ApplicationRequest?
  periods            SubscriptionPeriod[]
  billing            BillingRecord[]
  paymentIntents     PaymentIntent[]
  usage              UsageEvent[]

  @@index([tenantId, status])
  @@index([appId, status])
}

model ApplicationRequest {
  id              String       @id @default(cuid())
  subscriptionId  String       @unique
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  tenantId        String
  requestedBy     String
  requestedByName String       @default("")
  idempotencyKey  String       @unique
  termsVersion    String
  agreedAt        DateTime
  contactNote     String?      @db.Text
  operatorNote    String?      @db.Text
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime     @default(now())
}

model TrialUsage {
  id        String   @id @default(cuid())
  tenantId  String
  appId     String
  startedAt DateTime @default(now())

  @@unique([tenantId, appId])
}

model SubscriptionPeriod {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  kind           String // trial | free | paid
  startsAt       DateTime
  endsAt         DateTime?
  billingRecordId String?     @unique
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

model BillingRecord {
  id             String       @id @default(cuid())
  kind           String       @default("subscription") // subscription | usage
  tenantId       String
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amountJpy      Int
  status         String // due | paid | refunded | void
  periodStart    DateTime
  periodEnd      DateTime
  receiptRef     String?
  paidAmountJpy  Int?
  paidAt         DateTime?
  confirmedBy    String?
  refundedAt     DateTime?
  note           String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// direct（請求書・カード）| starpay（StarPay 利用料と合算）
  channel            String       @default("direct")
  starpayStatementId String?
  /// 請求作成時点の StarPay 加盟店番号（後から連携を変えても請求先は変わらない）
  starpayMerchantId  String?

  @@unique([subscriptionId, kind, periodStart])
  @@unique([receiptRef])
  @@index([tenantId])
  @@index([channel, status])
  @@index([starpayStatementId])
}

model Inquiry {
  id        String   @id @default(cuid())
  publicNo  String   @unique
  appId     String?
  app       App?     @relation(fields: [appId], references: [id])
  type      String
  name      String
  email     String
  company   String?
  tenantId  String?
  userId    String?
  message   String   @db.Text
  status    String   @default("open") // open | in_progress | closed
  assignee  String?
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentEntry {
  id        String   @id @default(cuid())
  kind      String // help | case | terms | privacy | topic
  slug      String
  title     String
  summary   String?  @db.Text
  body      String   @db.Text
  appId     String?
  app       App?     @relation(fields: [appId], references: [id])
  version   String   @default("1")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, slug])
}

model OperatorGrant {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      String   @default("operator") // admin | operator
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  actorType  String // user | operator | system
  tenantId   String?
  objectType String
  objectId   String
  action     String
  fromState  String?
  toState    String?
  reason     String?  @db.Text
  data       Json?
  createdAt  DateTime @default(now())

  @@index([objectType, objectId])
  @@index([createdAt])
}

/// 服务端会话。OAuth token 只保存在服务端，浏览器只持有 HttpOnly 会话 Cookie。
model Session {
  id            String   @id
  userId        String
  userName      String
  email         String?
  tenantId      String?
  tenantName    String?
  isOwner       Boolean  @default(false)
  authMode      String // oidc | demo
  accessToken   String?  @db.Text
  refreshToken  String?  @db.Text
  idToken       String?  @db.Text
  tokenExpiresAt DateTime?
  csrfToken     String
  lastVerifiedAt DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
}

model AuthState {
  id        String   @id // state
  verifier  String
  nonce     String
  returnTo  String   @default("/")
  createdAt DateTime @default(now())
}

/// 一次性应用启动票据（不把 MarketStars token 放在 URL）。
model LaunchTicket {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  appId     String
  userId    String
  userName  String
  tenantId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RankingEntry {
  id         String   @id @default(cuid())
  appId      String
  app        App      @relation(fields: [appId], references: [id])
  rank       Int
  count      Int
  computedAt DateTime

  @@index([computedAt])
}

model JobLock {
  name     String   @id
  lockedAt DateTime
  lastRunAt DateTime?
  lastResult String?  @db.Text
}

/// 租户的支付方式（只保存支付服务商的令牌和卡片摘要，不保存卡号）。
model PaymentMethod {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String // mockpay | stripe ...
  providerRef String   @unique
  brand       String
  last4       String
  expMonth    Int
  expYear     Int
  createdBy   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  subscriptions Subscription[]
  intents     PaymentIntent[]

  @@index([tenantId])
}

/// 一次收款意图。idempotencyKey 唯一，保证同一周期/同一操作只扣款一次。
model PaymentIntent {
  id              String       @id @default(cuid())
  tenantId        String
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  purpose         String // activate | renew | upgrade | convert_trial
  planVersionId   String
  plan            PlanVersion  @relation(fields: [planVersionId], references: [id])
  amountJpy       Int
  status          String       @default("requires_payment") // requires_payment | processing | succeeded | failed | canceled
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  providerChargeId String?     @unique
  failureReason   String?      @db.Text
  attempts        Int          @default(0)
  idempotencyKey  String       @unique
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([subscriptionId])
}

/// 用户评分评论（P1）：利用过该应用的空间成员可发表，每人每应用一条。
model Review {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id])
  tenantId  String
  tenantName String
  userId    String
  userName  String
  rating    Int
  title     String
  body      String   @db.Text
  status    String   @default("published") // published | hidden
  hiddenReason String?
  replyBody String?  @db.Text
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, userId])
  @@index([appId, status])
}

/// 统一模型网关的调用记录（Token 按量计费依据）。(appId, requestId) 唯一，防止重复计费。
model UsageEvent {
  id             String       @id @default(cuid())
  appId          String
  requestId      String
  tenantId       String
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  planVersionId  String
  model          String
  inputTokens    Int
  outputTokens   Int
  /// 单价快照（日元 / 100 万 Token）
  unitPriceJpyPerMTok Int
  /// 费用（千分之一日元）
  costMilliJpy   Int
  createdAt      DateTime     @default(now())

  @@unique([appId, requestId])
  @@index([subscriptionId, createdAt])
  @@index([tenantId, createdAt])
}

/// 供应商月度结算单（自动分账）。确定后不可改；之后发生的退款计入下月。
model PayoutStatement {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id])
  month         String // YYYY-MM（日本时间）
  grossJpy      Int
  refundJpy     Int
  platformFeeJpy Int
  payoutJpy     Int
  shareBps      Int
  lines         Json
  status        String   @default("confirmed") // confirmed | paid
  paidAt        DateTime?
  paidReference String?
  generatedAt   DateTime @default(now())

  @@unique([providerId, month])
}

/// 上传的图片（演示环境存数据库；生产建议 Cloud Storage）。
model Asset {
  id          String   @id @default(cuid())
  ownerType   String // provider | operator
  ownerId     String
  contentType String
  size        Int
  sha256      String
  data        Bytes    @db.LongBlob
  createdAt   DateTime @default(now())
}

/// AgentPay：空间 owner 签发给 AI 代理的支付授权。API key 只保存哈希，只显示一次。
model AgentMandate {
  id               String    @id @default(cuid())
  tenantId         String
  tenantName       String
  name             String
  keyPrefix        String
  keyHash          String    @unique
  scopes           String // 逗号分隔：catalog,subscribe
  allowedAppIds    Json? // null = 所有已发布应用
  monthlyBudgetJpy Int
  perTxLimitJpy    Int
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdBy        String
  createdAt        DateTime  @default(now())
  transactions     AgentTransaction[]

  @@index([tenantId])
}

/// 代理发起的每次购买请求（批准或拒绝都记录）。
model AgentTransaction {
  id             String       @id @default(cuid())
  mandateId      String
  mandate        AgentMandate @relation(fields: [mandateId], references: [id])
  tenantId       String
  appId          String?
  subscriptionId String?
  amountJpy      Int
  status         String // approved | denied | failed
  reason         String?      @db.Text
  idempotencyKey String
  createdAt      DateTime     @default(now())

  @@unique([mandateId, idempotencyKey])
  @@index([tenantId, createdAt])
}

/// 防篡改结算台帐：每条记录的 hash = sha256(prevHash + 规范化内容)。(kind, refId) 唯一，按定时任务顺序追加。
model LedgerEntry {
  seq        Int      @id @default(autoincrement())
  kind       String // payment | refund | payout_paid
  refId      String
  amountJpy  Int
  tenantId   String?
  providerId String?
  occurredAt DateTime
  payload    Json
  prevHash   String
  hash       String   @unique
  createdAt  DateTime @default(now())

  @@unique([kind, refId])
}

/// 台帐锚点：某一时刻的链头哈希（用于对外公布 / 将来写入区块链）。
model LedgerAnchor {
  id        String   @id @default(cuid())
  seq       Int
  hash      String
  entries   Int
  target    String   @default("none") // none（未上链）| 将来：chain 名称
  txRef     String?
  createdAt DateTime @default(now())
}

/// 领域事件 outbox：业务事务内写入，由定时任务分发为通知、邮件和提供商 Webhook。
model DomainEvent {
  id             String    @id @default(cuid())
  type           String
  tenantId       String?
  appId          String?
  subscriptionId String?
  payload        Json
  dedupeKey      String?   @unique
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  deliveries     WebhookDelivery[]

  @@index([processedAt, createdAt])
  @@index([appId, createdAt])
}

/// 站内通知（按空间；已读状态按用户记录在 NotificationRead）。
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String?
  kind      String
  title     String
  body      String   @db.Text
  link      String?
  ownerOnly Boolean  @default(false)
  createdAt DateTime @default(now())
  reads     NotificationRead[]

  @@unique([tenantId, eventId])
  @@index([tenantId, createdAt])
}

model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])
  userId         String
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
}

/// 空间的联系邮箱（owner 登录时从 SSO 的 email 声明记录）。
model TenantContact {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  email     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  body      String    @db.Text
  eventId   String?
  status    String    @default("pending") // pending | sent | failed
  attempts  Int       @default(0)
  lastError String?   @db.Text
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([eventId, to])
  @@index([status, createdAt])
}

/// 提供商为应用配置的 Webhook。签名密钥由 SESSION_SECRET 与端点 ID 派生，不入库。
model WebhookEndpoint {
  id         String   @id @default(cuid())
  appId      String
  url        String   @db.VarChar(1000)
  enabled    Boolean  @default(true)
  eventTypes String // 逗号分隔，* = 全部
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deliveries WebhookDelivery[]

  @@index([appId])
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id])
  eventId       String
  event         DomainEvent     @relation(fields: [eventId], references: [id])
  status        String          @default("pending") // pending | succeeded | failed | dead
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastStatus    Int?
  lastError     String?         @db.Text
  succeededAt   DateTime?
  createdAt     DateTime        @default(now())

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
}

/// 限流计数（固定窗口，多副本共享）。key 例：auth:ip:203.0.113.1
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// 账号注销申请。MarketStars 不删除身份（由 SSO 统一处理），只受理、检查前提并转交；交易记录依法保留。
model DeletionRequest {
  id           String   @id @default(cuid())
  userId       String
  userName     String
  email        String?
  tenantId     String?
  tenantName   String?
  /// 进行中的申请为 userId（唯一），结束后置 null，保证每人同时只有一份
  openKey      String?  @unique
  status       String   @default("submitted") // submitted | in_review | forwarded_to_sso | closed | rejected
  checks       Json
  reason       String?  @db.Text
  operatorNote String?  @db.Text
  ssoTicketRef String?
  handledBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// 空間（SSO テナント）と StarPay 加盟店の連携。合算請求を選べるのは連携済みの空間だけ。
model StarpayLink {
  tenantId     String   @id
  merchantId   String   @unique
  merchantName String
  linkedBy     String
  linkedAt     DateTime @default(now())
}

/// 月次の合算請求明細（StarPay 側の請求に載せる MarketStars 利用料）。回収確認で各請求を入金済みにする。
model StarpayStatement {
  id         String    @id @default(cuid())
  month      String    @unique // YYYY-MM（JST、利用期間の開始月）
  status     String    @default("open") // open（追加可）| exported（CSV 出力済み・追加不可）| settled（回収確認済み）
  totalJpy   Int
  itemCount  Int
  settledRef String?
  settledAt  DateTime?
  settledBy  String?
  createdBy  String
  createdAt  DateTime  @default(now())
}

/// デモ接入アプリ「クチコミ返信アシスタント」自身のデータ（空間ごとの作成履歴）。マーケットのデータとは別に、アプリ側で空間ごとに分けて保持する例。
model DemoAppReviewDraft {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  review    String   @db.Text
  rating    Int
  tone      String
  store     String
  aiText    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// MarketStars ホスティング（静的サイト）：開発者がアップロードした zip を検証（ビルド）した結果。ファイルは不変、本番切替は App.hostedBuildId。
model HostedBuild {
  id         String       @id @default(cuid())
  appId      String
  number     Int
  status     String       // building | ready | failed
  sha256     String
  fileCount  Int          @default(0)
  totalBytes Int          @default(0)
  log        Json
  uploadedBy String
  createdAt  DateTime     @default(now())
  finishedAt DateTime?
  files      HostedFile[]

  @@unique([appId, number])
}

model HostedFile {
  id          String      @id @default(cuid())
  buildId     String
  build       HostedBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  path        String      @db.VarChar(300)
  contentType String
  size        Int
  sha256      String
  data        Bytes       @db.MediumBlob

  @@unique([buildId, path])
}
